# API keys and environment configuration
#
# Google Maps Platform API key
# Required for Places search and Routing tools.
# Create one at: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New), Routes API
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API key — required for the AI planning agent.
# Create one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use for planning (default: gpt-4o).
OPENAI_MODEL=gpt-4o

# PostgreSQL connection URL for the trip storage database.
# Omit to use a local SQLite file (travel_planning.db) — suitable for development.
# Example PostgreSQL URL:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_planning

# Allowed CORS origins — JSON array of your frontend URL(s).
# Default allows localhost:3000 and localhost:3001 for local development.
# Example for production:
# CORS_ORIGINS=["https://your-frontend.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
